          "alias": "local",
          "params": {
            "maxTokens": 1024
          }
        }
      },
      "workspace": "/root/.openclaw/workspace",
      "bootstrapMaxChars": 2000,
      "bootstrapTotalMaxChars": 8000,
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 20000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 32000,
          "prompt": "Write a durable session note to memory/daily/YYYY-MM-DD.md. Capture only: decisions, architecture changes, debugging discoveries, open questions, and important constraints. If nothing important happened write NO_FLUSH.",
          "systemPrompt": "Be concise. Use bullet points. Do not copy the conversation."
        }
      },
      "heartbeat": {
        "every": "30m",
        "model": "ollama/qwen3.5:0.8b",
        "includeReasoning": false,
        "target": "none",
        "lightContext": true
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      },
      "sandbox": {
        "mode": "non-main",
        "workspaceAccess": "rw"
      }
    },
    "list": [
      {
        "id": "main",
        "name": "Jarvis",
        "workspace": "/root/.openclaw/workspace",
        "model": "zai/glm-4.7-flash",
        "subagents": {
          "allowAgents": [
            "researcher"
          ]
        }
      },
      {
        "id": "local-ops",
        "name": "Local Ops",
        "workspace": "/root/.openclaw/workspace",
        "model": "ollama/qwen3.5:0.8b"
      },
      {
        "id": "researcher",
        "name": "researcher",
        "workspace": "/root/.openclaw/workspace-researcher",
        "model": "minimax/MiniMax-M2.5"
      }
    ]
